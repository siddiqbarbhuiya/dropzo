# Environment for running the API's integration test suite (apps/api/src/**/*.integration-spec.ts
# and apps/api/test/**). Copy to .env.test. Points at the separate dropzo_test database created
# automatically by infrastructure/docker/init/01-create-test-database.sh - never the dev database.
NODE_ENV=test
PORT=3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dropzo_test
APP_DATABASE_URL=postgresql://dropzo_app:dropzo_app_dev_only@localhost:5432/dropzo_test

# Test-only fixed values (not secrets - this database never holds anything real). A fixed value
# here, unlike .env.example's generated one, keeps test output and fixtures reproducible.
JWT_ACCESS_SECRET=test-only-jwt-access-secret-not-for-real-use-00000
OTP_HASH_SECRET=test-only-otp-hash-secret-not-for-real-use-000000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_PROVIDER=dev
OTP_CODE_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_PER_PHONE_HOURLY_LIMIT=5
OTP_PER_IP_HOURLY_LIMIT=20
