# Optional overrides for the local Postgres container (infrastructure/docker/docker-compose.yml).
# Copy to infrastructure/docker/.env to customize - compose reads a .env file from this same
# directory automatically. Without this file, the defaults below are used, matching the root
# .env.example's DATABASE_URL. These are local-development-only values, never production secrets.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dropzo
POSTGRES_TEST_DB=dropzo_test
POSTGRES_PORT=5432
