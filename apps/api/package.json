{
    "name": "@dropzo/api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "nest start --watch",
        "build": "nest build",
        "start": "node dist/main.js",
        "lint": "nx eslint:lint",
        "lint:fix": "nx eslint:lint --fix",
        "typecheck": "nx tsc:typecheck",
        "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\""
    },
    "dependencies": {
        "@dropzo/shared-types": "0.1.0",
        "@nestjs/common": "^12.4.0",
        "@nestjs/config": "^12.1.1",
        "@nestjs/core": "^12.4.0",
        "@nestjs/platform-express": "^12.4.0",
        "@nestjs/swagger": "^12.1.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "joi": "^17.13.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@nestjs/cli": "^12.0.12",
        "@nestjs/schematics": "^12.0.13",
        "@nestjs/testing": "^12.4.0",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.1",
        "cross-env": "^7.0.3",
        "eslint": "^9.15.0",
        "jest": "^29.7.0",
        "prettier": "^3.3.3",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.15.0"
    },
    "jest": {
        "extensionsToTreatAsEsm": [
            ".ts"
        ],
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "moduleNameMapper": {
            "^(\\.{1,2}/.*)\\.js$": "$1"
        },
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.ts$": [
                "ts-jest",
                {
                    "useESM": true
                }
            ]
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
