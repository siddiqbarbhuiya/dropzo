{
    "name": "@dropzo/api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "nest start --watch",
        "build": "nest build",
        "start": "node dist/main.js",
        "lint": "nx eslint:lint",
        "lint:fix": "nx eslint:lint --fix",
        "typecheck": "nx tsc:typecheck",
        "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
        "test:integration": "node ../../node_modules/dotenv-cli/cli.js -e ../../.env.test -- cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.cjs --runInBand",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "prisma:generate": "prisma generate",
        "prisma:migrate:dev": "node ../../node_modules/dotenv-cli/cli.js -e ../../.env -- prisma migrate dev",
        "prisma:migrate:deploy": "node ../../node_modules/dotenv-cli/cli.js -e ../../.env -- prisma migrate deploy",
        "prisma:migrate:deploy:test": "node ../../node_modules/dotenv-cli/cli.js -e ../../.env.test -- prisma migrate deploy",
        "prisma:migrate:status": "node ../../node_modules/dotenv-cli/cli.js -e ../../.env -- prisma migrate status",
        "prisma:validate": "node ../../node_modules/dotenv-cli/cli.js -e ../../.env -- prisma validate",
        "prisma:studio": "node ../../node_modules/dotenv-cli/cli.js -e ../../.env -- prisma studio",
        "prisma:set-app-password": "node ../../node_modules/dotenv-cli/cli.js -e ../../.env -- node ../../scripts/set-app-role-password.mjs",
        "prisma:set-app-password:test": "node ../../node_modules/dotenv-cli/cli.js -e ../../.env.test -- node ../../scripts/set-app-role-password.mjs",
        "db:seed": "node ../../node_modules/dotenv-cli/cli.js -e ../../.env -- node --loader ts-node/esm prisma/seed.ts",
        "release-expired-reservations": "node ../../node_modules/dotenv-cli/cli.js -e ../../.env -- node dist/jobs/release-expired-reservations.js"
    },
    "dependencies": {
        "@dropzo/shared-types": "0.1.0",
        "@nestjs/common": "^12.4.0",
        "@nestjs/config": "^12.1.1",
        "@nestjs/core": "^12.4.0",
        "@nestjs/jwt": "^12.0.4",
        "@nestjs/platform-express": "^12.4.0",
        "@nestjs/swagger": "^12.1.1",
        "@nestjs/throttler": "^6.7.1",
        "@prisma/client": "^6.2.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "joi": "^17.13.3",
        "libphonenumber-js": "^1.13.15",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@nestjs/cli": "^12.0.12",
        "@nestjs/schematics": "^12.0.13",
        "@nestjs/testing": "^12.4.0",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.1",
        "@types/supertest": "^7.2.1",
        "cross-env": "^7.0.3",
        "dotenv-cli": "^8.0.0",
        "eslint": "^9.15.0",
        "jest": "^29.7.0",
        "prettier": "^3.3.3",
        "prisma": "^6.2.1",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.15.0"
    },
    "jest": {
        "extensionsToTreatAsEsm": [
            ".ts"
        ],
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "moduleNameMapper": {
            "^(\\.{1,2}/.*)\\.js$": "$1",
            "^@nestjs/throttler$": "<rootDir>/../test/mocks/throttler.mock.ts"
        },
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.ts$": [
                "ts-jest",
                {
                    "useESM": true
                }
            ]
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "nx": {
        "targets": {
            "dev": {
                "dependsOn": [
                    {
                        "target": "dev",
                        "projects": [
                            "infrastructure"
                        ]
                    }
                ]
            }
        }
    }
}
