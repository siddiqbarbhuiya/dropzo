{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "isolatedModules": true,
        "incremental": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "types": ["node", "jest"]
    },
    "include": ["src/**/*.ts"]
}
