NODE_ENV=development
PORT=3000

# Matches infrastructure/docker/docker-compose.yml's default local Postgres credentials.
# Local development only - never reuse these values anywhere a real network can reach them.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dropzo
POSTGRES_TEST_DB=dropzo_test
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dropzo

# Used by the running API at runtime instead of DATABASE_URL - a restricted role (created by the
# initial migration) that cannot UPDATE or DELETE ledger_transactions/ledger_entries. DATABASE_URL
# (the Postgres superuser) is still what Prisma CLI commands (migrate, seed, studio) use, since
# creating and altering tables needs the owner role. Falls back to DATABASE_URL if unset.
APP_DATABASE_URL=postgresql://dropzo_app:dropzo_app_dev_only@localhost:5432/dropzo

# Generate with: openssl rand -hex 32 (or any other 32+ byte random value). Required - there is
# no default, since a predictable secret would defeat the point of having one. Signs access tokens
# only - refresh tokens are opaque random values, hashed at rest, never JWTs, so they need no
# signing secret of their own (see docs/04-design/AUTHENTICATION-DESIGN.md).
JWT_ACCESS_SECRET=
# Generate with: openssl rand -hex 32. Used as an HMAC key when hashing OTP codes at rest.
OTP_HASH_SECRET=
# Generate with: openssl rand -hex 32. Hashes one-time pickup codes (BC-009) - deliberately
# separate from OTP_HASH_SECRET.
PICKUP_CODE_HASH_SECRET=
# Generate with: openssl rand -hex 32. Hashes one-time delivery-completion codes (BC-010) -
# deliberately separate from PICKUP_CODE_HASH_SECRET.
DELIVERY_CODE_HASH_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# 'dev' (default) logs the OTP to the server console and never sends a real SMS - safe for local
# development and CI, and the only provider implemented so far (see Phase 2 of BC-005 and
# docs/04-design/AUTHENTICATION-DESIGN.md). OTP_PROVIDER_API_KEY is for a future real SMS vendor;
# unused while OTP_PROVIDER=dev.
OTP_PROVIDER=dev
OTP_PROVIDER_API_KEY=
OTP_CODE_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_PER_PHONE_HOURLY_LIMIT=5
OTP_PER_IP_HOURLY_LIMIT=20

PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=

SENTRY_DSN=

STITCH_API_KEY=
